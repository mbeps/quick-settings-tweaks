{
	"$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!media",
			"!po",
			"!schemas",
			"!tmp",
			"!.github",
			"!README.md",
			"!CREDITS.md"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["metadata.json"],
			"formatter": {
				"indentStyle": "space",
				"indentWidth": 2
			}
		},
		{
			"includes": ["src/styles/**/*.scss"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnknownProperty": "off",
						"noUnknownFunction": "off"
					},
					"complexity": {
						"noImportantStyles": "off"
					}
				}
			}
		}
	]
}
