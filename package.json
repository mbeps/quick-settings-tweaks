	"type": "module",
	"packageManager": "pnpm@12.15.0",
	"sideEffects": false,
	"license": "LGPL-3.0-or-later",
	"homepage": "https://github.com/mbeps/quick-settings-tweaks#readme",
	"private": true,
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"build": "bash install.sh build",
		"ext:install": "bash install.sh install",
		"enable": "bash install.sh enable",
		"log": "bash install.sh log",
		"compile-preferences": "bash install.sh compile-preferences",
		"create-release": "bash install.sh create-release",
		"update-po": "bash install.sh update-po",
		"dev": "bash install.sh dev"
	},
	"bugs": {
		"url": "https://github.com/mbeps/quick-settings-tweaks/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mbeps/quick-settings-tweaks.git"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.7",
		"sass": "^1.83.4",
		"typescript": "^5.7.3"
	},
	"dependencies": {
		"@girs/gjs": "^4.0.0-beta.38",
		"@girs/gnome-shell": "^49.1.0"
	}
